# Build artifacts
# Note: target/ now lives at the workspace root because Cargo shares one target
# directory across all workspace members.
/target/

# Cargo.lock IS committed on purpose.
# This is an application, not a library: locking the dependency graph keeps the
# SQLCipher/OpenSSL build reproducible across machines and reinstalls.
# Do NOT add Cargo.lock to this file.

# Node / frontend (app/ is created later)
node_modules/
dist/
dist-ssr/
*.local

# Tauri build output
app/src-tauri/target/
app/src-tauri/gen/

# Editor / OS noise
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db
Desktop.ini

# Local verification scratch: probe writes throwaway test databases here.
probe/probe-out*/
probe/*.db
probe/*.db-journal
probe/*.db-wal
probe/*.db-shm

# 构建日志（scripts 里的脚本会产生多种命名的日志，统一忽略）
_build*.log
_app*.log
_dev*.log
_bp*.log
*.log

# 本地验证时产生的临时文件
probe-out/**
target/**/*.d

# 本地界面验收证据（验证脚本 / 日志 / 截图）—— 留给人看，不进版本库。
# 目录按版本命名（如 _verify-2.9/、_ui-verify-p2-0/），彼此不覆盖，
# 方便回查"这一版当时是怎么验的"。
_verify-*/
_ui-verify*/

# Never commit real diary data or key material
*.diarydb
crypto_meta.bin
lockout.json
# 免密打开的钥匙文件（它的内容就是库密钥本身，明文）。
# 下面的 /data/ 已经覆盖了它 —— 这里再单独列一行，是为了防止将来
# 数据目录挪位置（比如改成 %APPDATA%）时把钥匙一起提交上去。
auto_login.json

# 日记数据目录 —— 绝对不要提交。
# 应用是便携式的，数据存在项目里的 data/ 目录（见 commands::resolve_data_dir）。
# 里面有：加密数据库、加密元信息(salt+KDF参数)、锁定状态、附件。
# 这些是用户的私人数据：加密库不该进版本库，而 crypto_meta.json 与
# lockout.json 是明文，更不该提交。
/data/
app/data/
